<div class="theme-switch" role="group" aria-label="Color theme">
  <button
    type="button"
    class="theme-switch__btn"
    data-theme-choice="light"
    aria-pressed="false"
    title="Light theme">Light</button>
  <button
    type="button"
    class="theme-switch__btn"
    data-theme-choice="dark"
    aria-pressed="false"
    title="Dark theme">Dark</button>
  <button
    type="button"
    class="theme-switch__btn"
    data-theme-choice="system"
    aria-pressed="false"
    title="Use system setting">System</button>
</div>
