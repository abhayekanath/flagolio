---
import type { FlagGridItem } from "../../lib/flagAssetMaps";
import HomeLeftNavTabs from "./HomeLeftNavTabs";
import GitHubStarsLink from "./GitHubStarsLink";
import FlagGrid from "../flag-grid/FlagGrid.astro";

interface Pkg {
  name: string;
  version: string;
  license: string;
  description: string;
}

interface Props {
  pkg: Pkg;
  npmUrl: string;
  repoUrl?: string;
  /** `owner/repo` for GitHub API star count */
  githubRepo?: string;
  flagCount: number;
  items: FlagGridItem[];
}

const { pkg, npmUrl, repoUrl, githubRepo, flagCount, items } = Astro.props;
const docPkg = { name: pkg.name, license: pkg.license };
const installCmd = `npm install ${pkg.name}`;
const year = new Date().getFullYear();
---

<main
  class="mx-auto flex h-screen min-h-0 w-full max-w-[1800px] flex-col overflow-hidden bg-[#0f0f0f] text-zinc-100 [background-image:linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:40px_40px] lg:grid lg:h-full lg:min-h-0 lg:grid-cols-[minmax(0,520px)_minmax(0,1fr)]"
  aria-labelledby="home-title"
>
  <!-- Left: fills viewport height; scrolls only if content overflows -->
  <section
    class="flex min-h-0 w-full min-w-0 shrink-0 flex-col justify-between px-[24px] pb-[24px] pt-[24px] md:px-[40px] md:pb-[28px] md:pt-[28px] lg:h-dvh lg:overflow-y-auto lg:border-r lg:border-white/10 lg:px-[32px] lg:pr-[28px] xl:px-[40px]"
  >
    <HomeLeftNavTabs
      client:load
      docPkg={docPkg}
      installCmd={installCmd}
      flagCount={flagCount}
      pkgDescription={pkg.description}
    />

    <footer class="mt-[40px] flex justify-between items-center gap-[16px] border-t border-white/10 pt-[24px] md:mt-[32px] lg:mt-[40px]">
      <nav
        class="flex flex-wrap items-center gap-x-[14px] gap-y-[8px] text-[13px] text-zinc-500"
        aria-label="Page"
      >
        <a
          class="group inline-flex items-center gap-[6px] text-zinc-300 underline-offset-[3px] transition hover:text-white"
          href={npmUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i
            class="bxl bx-npm text-[22px] leading-none text-[#cb3837] transition group-hover:text-[#e85d4f]"
            aria-hidden="true"
          ></i>
          <span>npm</span>
        </a>
        {
          repoUrl ? (
            <>
              <span class="text-zinc-600" aria-hidden="true">·</span>
              <a
                class="group inline-flex items-center gap-[6px] text-zinc-300 underline-offset-[3px] transition hover:text-white"
                href={repoUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <i
                  class="bxl bx-github text-[20px] leading-none text-zinc-400 transition group-hover:text-white"
                  aria-hidden="true"
                ></i>
                <span>GitHub</span>
              </a>
            </>
          ) : null
        }
        {
          githubRepo && repoUrl ? (
            <>
              <span class="text-zinc-600" aria-hidden="true">·</span>
              <GitHubStarsLink client:load repoFullName={githubRepo} repoUrl={repoUrl} />
            </>
          ) : null
        }
      </nav>
      <p class="text-[12px] text-zinc-600">
        v{pkg.version} · © {year} flagolio
      </p>
    </footer>
  </section>
  <!-- Right: scroll area + bottom-centered float (absolute to #browse, not viewport) -->
  <section
    id="browse"
    class="relative isolate flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden text-foreground h-dvh"
  >
    <div
      class="min-h-0 flex-1 overflow-y-auto pb-20 px-6 [scrollbar-gutter:stable]"
    >
      <FlagGrid items={items} />
    </div>
    <div
      id="flag-code-float"
      class="flag-code-float pointer-events-auto absolute bottom-32 left-1/2 z-[50] hidden w-[min(100%,560px)] max-w-full -translate-x-1/2"
      role="region"
      aria-label="Flag icon markup"
      aria-hidden="true"
    >
      <div class="flag-code-float__inner">
        <code id="flag-code-float-value" class="flag-code-float__code"></code>
        <button
          type="button"
          id="flag-code-float-copy"
          class="flag-code-float__btn flag-code-float__copy"
          aria-label="Copy markup to clipboard"
        >
          <i class="bx bx-copy" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="flag-code-float-dismiss"
          class="flag-code-float__btn flag-code-float__btn--dim"
          aria-label="Dismiss"
        >
          <i class="bx bx-x" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </section>
</main>
