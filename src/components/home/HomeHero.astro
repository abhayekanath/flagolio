---
import "../../styles/home-hero.css";

import { getFlagLabel } from "../../lib/flagLabel";

interface Pkg {
  name: string;
  version: string;
  license: string;
  description: string;
  repository?: { url?: string } | string;
}

interface Props {
  pkg: Pkg;
}

const { pkg } = Astro.props;

const repoRaw =
  pkg.repository && typeof pkg.repository === "object" && pkg.repository.url
    ? String(pkg.repository.url)
    : "";
const repoUrl = repoRaw.replace(/^git\+/, "").replace(/\.git$/, "");
const npmUrl = `https://www.npmjs.com/package/${encodeURIComponent(pkg.name)}`;
---

<section class="home-hero" aria-labelledby="home-title">
  <span class="home-meta">
    <span class="home-pkg">{pkg.name}</span>
    <span class="home-ver">v{pkg.version}</span>
    <span class="home-license">{pkg.license}</span>
  </span>
  <h1 id="home-title" class="home-title">{pkg.name}</h1>
  <p class="home-lede">{pkg.description}</p>
  <div class="home-demo" role="group" aria-label="CSS class flag examples">
    <span class="home-demo__label">Class icons</span>
    <i class="flag gb" role="img" aria-label={getFlagLabel("us")}></i>
    <i class="flag square gb" role="img" aria-label={getFlagLabel("gb")}></i>
    <i class="flag round gb" role="img" aria-label={getFlagLabel("gb")}></i>
  </div>
  <p class="home-links">
    <a href={npmUrl} target="_blank" rel="noopener noreferrer">npm</a>
    {
      repoUrl ? (
        <>
          <span class="home-links__sep" aria-hidden="true">·</span>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source</a>
        </>
      ) : null
    }
    <span class="home-links__sep" aria-hidden="true">·</span>
    <button
      type="button"
      id="docs-modal-open"
      class="home-links__btn"
      aria-haspopup="dialog"
      aria-controls="docs-modal">Documentation</button>
    <span class="home-links__sep" aria-hidden="true">·</span>
    <a href="#browse">Browse flags</a>
  </p>
  <pre class="home-code" tabindex="0"><code>npm install {pkg.name}</code></pre>
  <p class="home-note">Node.js ≥ 18 · ESM</p>
</section>
