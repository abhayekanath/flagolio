---
interface Props {
  npmUrl: string;
  repoUrl?: string;
}

const { npmUrl, repoUrl } = Astro.props;
---

<header class="mb-[28px] w-full shrink-0 text-zinc-100" aria-label="Site">
  <div class="flex flex-wrap items-center gap-x-[24px] gap-y-[8px] md:gap-x-[32px]">
    <a
      href="/"
      class="flex shrink-0 items-center gap-[8px] text-[18px] font-bold tracking-tight text-white"
      aria-label="flagolio home"
    >
      <img
        src="/logo.svg"
        alt=""
        width="32"
        height="32"
        class="size-[32px] shrink-0 rounded-[8px]"
        aria-hidden="true"
      />
    </a>

    <nav
      class="flex flex-wrap items-center gap-[12px] text-[11px] font-medium uppercase tracking-[0.18em] text-zinc-400"
      aria-label="Quick links"
    >
      <a class="transition-colors hover:text-white" href={npmUrl} target="_blank" rel="noopener noreferrer">npm</a>
      <span class="text-zinc-600" aria-hidden="true">/</span>
      {
        repoUrl ? (
          <a class="transition-colors hover:text-white" href={repoUrl} target="_blank" rel="noopener noreferrer">
            Source
          </a>
        ) : (
          <span class="text-zinc-500">Source</span>
        )
      }
      <span class="text-zinc-600" aria-hidden="true">/</span>
      <a class="transition-colors hover:text-white" href="#browse">Flags</a>
    </nav>
  </div>
</header>
