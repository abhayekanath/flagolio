---
import { CONTINENT_OPTIONS } from "../../lib/flagContinent";
---

<form id="flag-toolbar" class="toolbar-dock w-full" role="search" aria-label="Search and filter flags">
  <div class="toolbar">
    <fieldset class="toolbar__filters">
      <legend class="sr-only">Filter flags</legend>
      <div class="toolbar__field">
        <label class="toolbar__label sr-only" for="filter">Search</label>
        <div class="toolbar__control">
          <i class="bx bx-search toolbar__control-icon" aria-hidden="true"></i>
          <input
            type="search"
            id="filter"
            name="q"
            class="toolbar__input"
            placeholder="Name or ISO code…"
            autocomplete="off"
          />
        </div>
      </div>
      <div class="toolbar__field">
        <label class="toolbar__label sr-only" for="continent">Region</label>
        <div class="toolbar__control toolbar__control--select">
          <i class="bx bx-globe toolbar__control-icon" aria-hidden="true"></i>
          <select id="continent" name="continent" class="toolbar__select" aria-label="Filter by continent">
            {CONTINENT_OPTIONS.map(({ value, label }) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <i class="bx bx-chevron-down toolbar__control-chevron" aria-hidden="true"></i>
        </div>
      </div>
    </fieldset>
    <div class="toolbar__tabs-row">
      <div class="toolbar__aspect">
        <div class="tabs" role="radiogroup" aria-label="Aspect ratio">
          <input type="radio" name="aspect" id="tab-4x3" value="4x3" class="tabs__radio sr-only" checked />
          <label for="tab-4x3" class="tabs__tab">
            <i class="bx bx-rectangle" aria-hidden="true"></i>
            <span>Default</span>
          </label>
          <input type="radio" name="aspect" id="tab-1x1" value="1x1" class="tabs__radio sr-only" />
          <label for="tab-1x1" class="tabs__tab">
            <i class="bx bx-square" aria-hidden="true"></i>
            <span>Square</span>
          </label>
          <input type="radio" name="aspect" id="tab-rounded" value="rounded" class="tabs__radio sr-only" />
          <label for="tab-rounded" class="tabs__tab">
            <i class="bx bx-circle" aria-hidden="true"></i>
            <span>Rounded</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</form>
