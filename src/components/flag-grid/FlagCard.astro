---
interface Props {
  code: string;
  name: string;
  hrefDefault: string;
  hrefSquare: string;
  hrefRound: string;
  continent: string;
}

const { code, name, hrefDefault, hrefSquare, hrefRound, continent } = Astro.props;
---

<article
  class="card"
  role="button"
  tabindex="0"
  data-code={code}
  data-label={name}
  data-name={name.toLowerCase()}
  data-continent={continent}
  data-href-default={hrefDefault}
  data-href-square={hrefSquare}
  data-href-round={hrefRound}
  aria-label={`${name}, ${code}`}
>
  <div class="thumb thumb--default">
    <div class="thumb__clip">
      <img src={hrefDefault} alt="" width="120" height="80" loading="lazy" />
    </div>
  </div>
</article>
