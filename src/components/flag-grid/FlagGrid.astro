---
import "../../styles/flag-grid.css";

import type { FlagGridItem } from "../../lib/flagAssetMaps";
import { getFlagContinent } from "../../lib/flagContinent";

import FlagCard from "./FlagCard.astro";
import FlagGridHeader from "./FlagGridHeader.astro";
import FlagGridToolbar from "./FlagGridToolbar.astro";

interface Props {
  items: FlagGridItem[];
}

const { items } = Astro.props;

const lede = `${items.length} entries · search · hover a flag for name and code`;
---

<div class="page">
  <FlagGridHeader lede={lede} />
  <FlagGridToolbar />
  <div class="grid" id="grid" role="tabpanel" aria-labelledby="tab-4x3">
    {
      items.map((item) => (
        <FlagCard
          {...item}
          continent={getFlagContinent(item.code)}
        />
      ))
    }
  </div>
</div>
