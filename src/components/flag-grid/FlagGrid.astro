---
import type { FlagGridItem } from "../../lib/flagAssetMaps";
import { getFlagContinent } from "../../lib/flagContinent";

import FlagCard from "./FlagCard.astro";
import FlagGridToolbar from "./FlagGridToolbar.astro";

interface Props {
  items: FlagGridItem[];
}

const { items } = Astro.props;
---

<FlagGridToolbar />
<div class="grid w-full pb-52" id="grid" role="tabpanel" aria-labelledby="tab-4x3">
  {
    items.map((item) => (
      <FlagCard
        {...item}
        continent={getFlagContinent(item.code)}
      />
    ))
  }
</div>
