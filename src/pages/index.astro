---
import { FLAG_CODES } from "@flagolio/flags";

import pkg from "../../package.json";

interface RootPkg {
  name: string;
  version: string;
  license?: string;
  description?: string;
  displayNpmPackage?: string;
  repository?: { url?: string } | string;
}

const root = pkg as RootPkg;
const flagsPkg = {
  name: root.displayNpmPackage ?? root.name,
  version: root.version,
  license: root.license ?? "MIT",
  description: root.description ?? "",
  repository: root.repository,
};

import BaseLayout from "../components/layout/BaseLayout.astro";
import HomeLanding from "../components/home/HomeLanding.astro";

import { buildFlagAssetMaps, buildFlagGridItems } from "../lib/flagAssetMaps";
import { buildFlagIconCss } from "../lib/flagIconCss";
import { getFlagLabel } from "../lib/flagLabel";
import { parseGitHubRepoFromUrl } from "../lib/githubRepo";
import { buildHomeJsonLd, resolveCanonicalUrl } from "../lib/seo";

const all = import.meta.glob(
  "@flags/**/*.svg",
  { eager: true, query: "?url", import: "default" },
) as Record<string, string>;

const maps = buildFlagAssetMaps(all);
const items = buildFlagGridItems(maps, getFlagLabel);
const flagIconCss = buildFlagIconCss(
  FLAG_CODES,
  maps.mapDefault,
  maps.mapSquare,
  maps.mapRound,
);

if (!Astro.site) {
  throw new Error("Set `site` in `astro.config.mjs` (or PUBLIC_SITE_URL) for canonical URLs and sitemap.");
}

const canonicalURL = resolveCanonicalUrl(Astro.site, Astro.url.pathname);
const siteRoot = resolveCanonicalUrl(Astro.site, "/").href.replace(/\/$/, "");

const repoRaw =
  flagsPkg.repository && typeof flagsPkg.repository === "object" && flagsPkg.repository.url
    ? String(flagsPkg.repository.url)
    : "";
const codeRepository = repoRaw.replace(/^git\+/, "").replace(/\.git$/, "") || undefined;

const pageTitle = `Flagolio · ISO 3166-1 alpha-2 flag SVGs for npm`;
const pageDesc = `${flagsPkg.description} Browse ${FLAG_CODES.length}+ flags in default (wide), square, and round. TypeScript helpers: FLAG_CODES, flagAssetUrl, getFlagPath. Install with npm.`;

const jsonLd = buildHomeJsonLd({
  siteUrl: siteRoot,
  name: flagsPkg.name,
  description: pageDesc,
  version: flagsPkg.version,
  license: flagsPkg.license,
  codeRepository,
});

const keywords = [
  "ISO 3166-1 alpha-2",
  "country flags",
  "SVG flags",
  "npm",
  "TypeScript",
  "default wide flags",
  "square flags",
  "round flags",
  "flag icons",
  "Astro",
].join(", ");

const npmUrl = `https://www.npmjs.com/package/${encodeURIComponent(flagsPkg.name)}`;
const repoUrlRaw =
  flagsPkg.repository && typeof flagsPkg.repository === "object" && flagsPkg.repository.url
    ? String(flagsPkg.repository.url)
    : "";
const repoUrl = repoUrlRaw.replace(/^git\+/, "").replace(/\.git$/, "") || undefined;
const githubRepo = parseGitHubRepoFromUrl(repoUrl);
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  flagIconCss={flagIconCss}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  keywords={keywords}
>
  <HomeLanding
    pkg={flagsPkg}
    npmUrl={npmUrl}
    repoUrl={repoUrl}
    githubRepo={githubRepo}
    flagCount={FLAG_CODES.length}
    items={items}
  />
</BaseLayout>

<script>
  import "../scripts/entry.client.ts";
</script>
