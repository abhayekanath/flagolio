{
  "name": "@flagolio/flags",
  "version": "0.0.4",
  "description": "ISO 3166-1 alpha-2 SVG flags (default wide, square, round) with TypeScript helpers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhayekanath/flagolio.git",
    "directory": "flags"
  },
  "homepage": "https://flagolio.vercel.app/",
  "bugs": {
    "url": "https://github.com/abhayekanath/flagolio/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./svg/*": "./svg/*",
    "./flagolio.cdn.css": "./dist/flagolio.cdn.css"
  },
  "files": [
    "dist",
    "svg"
  ],
  "scripts": {
    "build": "node scripts/generate-round.mjs && node scripts/generate-codes.mjs && node scripts/generate-named-exports.mjs && tsc -p tsconfig.build.json && node scripts/generate-cdn-css.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
