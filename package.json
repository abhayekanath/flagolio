{
  "name": "flagolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "SVG country and region flags (4:3, 1:1, and round 1:1) with TypeScript helpers — Astro site and flag assets.",
  "license": "MIT",
  "displayNpmPackage": "@flagolio/flags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/flagolio.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/flagolio/issues"
  },
  "homepage": "https://github.com/your-org/flagolio#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:flags": "node flags/scripts/generate-round.mjs && node flags/scripts/generate-codes.mjs && tsc -p flags/tsconfig.build.json",
    "prebuild": "npm run build:flags",
    "build": "astro build",
    "dev": "npm run build:flags && astro dev",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.0.8",
    "countries-list": "^3.3.0",
    "gsap": "^3.14.2",
    "i18n-iso-countries": "^7.14.0",
    "lenis": "^1.3.19"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
