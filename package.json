{
  "name": "flagolio",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "description": "ISO 3166-1 alpha-2 SVG flags (default wide, square, round) with TypeScript helpers — Astro site and flag assets.",
  "license": "MIT",
  "displayNpmPackage": "@flagolio/flags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhayekanath/flagolio.git"
  },
  "bugs": {
    "url": "https://github.com/abhayekanath/flagolio/issues"
  },
  "homepage": "https://flagolio.vercel.app/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:favicon-ico": "node scripts/build-favicon-ico.mjs",
    "build:flags": "node flags/scripts/generate-round.mjs && node flags/scripts/generate-codes.mjs && node flags/scripts/generate-named-exports.mjs && tsc -p flags/tsconfig.build.json && node flags/scripts/generate-cdn-css.mjs",
    "prebuild": "npm run build:flags",
    "build": "astro build",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:flags && astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "publish:flags": "npm run build:flags && npm publish ./flags"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.3.0",
    "gsap": "^3.14.2",
    "i18n-iso-countries": "^7.14.0",
    "lenis": "^1.3.20",
    "lucide-react": "^1.6.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/sitemap": "^3.7.1",
    "@types/node": "^25.5.0",
    "png-to-ico": "^3.0.1",
    "typescript": "~5.9.3"
  }
}
